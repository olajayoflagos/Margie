rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      // Set via a custom claim on the admin's Firebase Auth account (see
      // functions/index.js - ensureAdminClaim). The email check is defense
      // in depth: admin@margies.com.ng is the only mailbox this app ever
      // treats as the admin, so even a stray/stale `admin` claim on some
      // other account can't grant access here.
      return isSignedIn()
        && request.auth.token.admin == true
        && request.auth.token.email == "admin@margies.com.ng";
    }

    // Rooms: public catalog data, read-only from the client.
    // Only the admin (or a trusted server environment) may write.
    match /rooms/{roomId} {
      allow read: if true;
      allow write: if isAdmin();

      match /availability/{entryId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    // Bookings: a guest may create their own booking request (as
    // "pending_payment" only) and read/cancel their own bookings.
    // Nobody but the admin can mark a booking "confirmed" or touch
    // amountPaid/paymentRef after creation - that happens server-side in the
    // verifyPaystackPayment / processNewBooking Cloud Functions using the
    // Admin SDK, which bypasses these rules entirely.
    match /bookings/{bookingId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);

      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == "pending_payment";

      // Owner may only ever flip their own booking to "cancelled" - nothing else.
      allow update: if isAdmin()
        || (isSignedIn()
            && resource.data.userId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "cancelledAt"])
            && request.resource.data.status == "cancelled");

      allow delete: if isAdmin();
    }

    // Contact messages: anyone can submit one, only the admin can read/manage them.
    match /messages/{messageId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Articles: publicly readable once published; only the admin can write.
    match /articles/{articleId} {
      allow read: if resource.data.status == "published" || isAdmin();
      allow write: if isAdmin();
    }

    // "Buy the owner a coffee" tips. Written only by the Cloud Function
    // (Admin SDK bypasses these rules), readable only by the admin.
    match /support_payments/{paymentId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
