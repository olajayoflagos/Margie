# Copy this file to functions/.env and fill in the real values.
# functions/.env is read automatically by Firebase when you deploy.
# Never commit the real .env - it contains a secret key.

# Live mode
PAYSTACK_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxx

# Test mode (pair this with VITE_PAYSTACK_PUBLIC_KEY=pk_test_... in the frontend)
# PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx

# --- Transactional email (welcome + booking confirmation) ---
# Sent via EmailJS, using the templates already built in your EmailJS
# dashboard - this is a completely separate system from Firebase
# Authentication's own emails (verification links, password resets), which
# Firebase sends itself and need no config here at all.
#
#   EMAILJS_SERVICE_ID       Dashboard -> Email Services -> your service's ID
#   EMAILJS_PUBLIC_KEY       Dashboard -> Account -> API Keys -> "Public Key"
#   EMAILJS_PRIVATE_KEY      Same page -> "Private Key". Required for sending
#                             from a server (this Cloud Function) instead of a
#                             browser - EmailJS otherwise blocks it since
#                             there's no page origin to check. Keep this
#                             secret; never put it in frontend code.
#   EMAILJS_WELCOME_TEMPLATE_ID   Dashboard -> Email Templates -> your welcome template's ID
#   EMAILJS_BOOKING_TEMPLATE_ID   Dashboard -> Email Templates -> your booking template's ID
#   EMAILJS_COFFEE_TEMPLATE_ID    Optional - only set once a coffee-thank-you
#                                  template exists; until then that email is
#                                  just skipped, nothing breaks.
#
# Each template should set its "To Email" field to {{to_email}} - see the
# comment above sendTemplateEmail in index.js for every param name each
# email sends (to_name, room_name, check_in, amount_paid, etc.) so you can
# reference them in the template editor.
EMAILJS_SERVICE_ID=service_xxxxxxx
EMAILJS_PUBLIC_KEY=your_emailjs_public_key
EMAILJS_PRIVATE_KEY=your_emailjs_private_key
EMAILJS_WELCOME_TEMPLATE_ID=template_xxxxxxx
EMAILJS_BOOKING_TEMPLATE_ID=template_xxxxxxx
# EMAILJS_COFFEE_TEMPLATE_ID=template_xxxxxxx

# Optional - referenced as {{owner_email}} in the booking/coffee templates if
# you want to CC/BCC yourself; set that up in the template's "CC"/"BCC" field
# in the EmailJS editor, since EmailJS calls don't take a bcc option directly.
OWNER_EMAIL=info@margies.com.ng

# --- Admin access ---
# The one mailbox that is ever treated as the admin. Whoever is signed in
# with this exact address on /admin-login self-grants the `admin` custom
# claim (see ensureAdminClaim in index.js) - there's no UID to keep in sync
# by hand, and no separate step needed to move admin access to a different
# account.
ADMIN_EMAIL=admin@margies.com.ng
