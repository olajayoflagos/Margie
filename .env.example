# Copy to .env.local (git-ignored) and fill in.
# Everything here is exposed in the browser bundle - never put a secret key here.

# Paystack PUBLIC key. Use pk_test_... to test without moving real money.
VITE_PAYSTACK_PUBLIC_KEY=pk_live_xxxxxxxxxxxx

# Tip amount for the "buy the owner a coffee" page, in naira.
VITE_SUPPORT_AMOUNT_NGN=500

# Shown as a fallback "from"/reply-to reference in a couple of places.
# The email templates themselves now live server-side in functions/index.js.
VITE_OWNER_EMAIL=you@example.com
